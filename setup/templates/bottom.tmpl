[flags]
mem_as_value = true
show_table_scroll_position = true

[colors]
# cyan      1f88a2
# blue      2d77ce
# green     2e7d32
# sea green	3ca341
# grey      999999
# purple    7b1fa2
# magenta   a21f7b
# orange    ff9800
# red       d32f2f
# yellow    FFFF5F
# black     252526
# white     ECEFF4

# Represents the colour of table headers (processes, CPU, disks, temperature).
# all
table_header_color="@col_seagreen@"
widget_title_color="@col_light@"
border_color="@col_grey_mid@"
highlighted_border_color="@col_green@"
text_color="@col_light@"
selected_text_color="@col_light@"
selected_bg_color="@col_green@"
graph_color="@col_light@"
# cpu
all_cpu_color="@col_light@"
avg_cpu_color="@col_red@"
cpu_core_colors=["@col_nord10@","@col_nord9@","@col_nord4@","@col_nord15@","@col_nord14@","@col_nord13@","@col_nord12@","@col_nord11@"]
# memory
ram_color="@col_chartblue@"
swap_color="@col_red@"
# network
rx_color="@col_chartblue@"
tx_color="@col_red@"

[[row]]
  ratio=30
  [[row.child]]
  type="cpu"
[[row]]
  ratio=30
  [[row.child]]
    type="mem"
  [[row.child]]
    type="net"
[[row]]
  ratio=40
  [[row.child]]
    type="proc"
    default=true
  [[row.child]]
    [[row.child.child]]
      type="temp"
    [[row.child.child]]
      type="disk"
