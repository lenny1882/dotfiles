[Desktop Entry]
Type=Application
Name=nnn
Comment=Terminal file manager
Exec=/bin/sh -c "exec \\"\\$HOME/.config/herbstluftwm/scripts/tui-wrap.sh\\" \\"\\$HOME/.config/herbstluftwm/scripts/nnn-wrap.sh\\" \\"\\$@\\"" sh %f
Terminal=false
Icon=nnn
