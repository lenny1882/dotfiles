# adb without root: access for the user logged in at the seat (uaccess) and for adbusers.
# Same permissions as https://github.com/M0Rf30/android-udev-rules
# After editing: sudo udevadm control --reload-rules, then replug the phone.

# Essential PH1
SUBSYSTEM=="usb", ATTR{idVendor}=="2e17", MODE="0660", GROUP="adbusers", TAG+="uaccess"

# Pixel 2
SUBSYSTEM=="usb", ATTR{idVendor}=="18d1", MODE="0660", GROUP="adbusers", TAG+="uaccess"
