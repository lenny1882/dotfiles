# in order to use adb on a device without running adb server as sudo, set mode to 0666
#
# lsusb
# Bus 001 Device 012: ID 2e17:c032 Essential Products PH-1
# use "2e17" as ATTR{idVender}
#
# set permissions and reload
# sudo chmod a+r /etc/udev/rules.d/51-android.rules
# adb kill-server
# sudo udevadm control --reload-rules
# adb start
#
# If necessary:
# 	Android system settings > Developer settings > revoke usb debugging authorisations

# Essential PH1
SUBSYSTEM=="usb", ATTR{idVendor}=="2e17", MODE="0666", GROUP="adbusers"

# Pixel 2
SUBSYSTEM=="usb", ATTR{idVendor}=="18d1", MODE="0666", GROUP="adbusers"
