#!/usr/bin/env bash
source ~/.config/herbstluftwm/variables.autostart

# --------------------------------
# environment for everything herbstluftwm starts - the shellrc files are not read by this session
# GTK and Qt file dialogs go through the portal, whose FileChooser is nnn (scripts/nnn-portal.py)
hc export GTK_USE_PORTAL=1
hc export QT_QPA_PLATFORMTHEME=xdgdesktopportal

# --------------------------------
# commands

# autostart - but only if custom var has not been created
if hc silent new_attr bool my_not_first_autostart ; then 
    hc spawn $SCRIPTS_DIR/xrdb-wrap.sh ~/.Xresources
    hc spawn picom --config ~/.config/picom.conf &
    hc spawn numlockx on &
    hc spawn $SCRIPTS_DIR/background.sh &

    hc spawn easystroke enable &
    hc spawn rambox &
    # hc spawn bash -c "vivaldi --password-store=basic" &
    hc spawn vivaldi &
    hc spawn obsidian &
    hc spawn spotify &
fi

# --------------------------------
# monitor watcher

pgrep -u $UID -f '^(/usr/bin/|/bin/)?bash .*monitor_changes\.sh$' >/dev/null \
    || hc spawn $SCRIPTS_DIR/monitor_changes.sh

# --------------------------------
# finalise

# unlock before monitors get padded, else panel loads above windows
hc unlock

# load the panel
$SCRIPTS_DIR/panel.sh $col_active $col_purple &

# one hook loop per session; a reload runs this file again
if ! hc silent new_attr bool my_hook_loop_started; then
    exit 0
fi

herbstclient --idle | while read hook name winid; do
    $SCRIPTS_DIR/rule_hook.sh $hook $name $winid
done

sleep 10
hc unrule rambox-startup-onetime