#!/usr/bin/env bash
source ~/.config/herbstluftwm/variables.autostart

# --------------------------------
# rules
# `xprop`
# WM_CLASS - first entry is `instance`, second is `class`
# _NET_WM_WINDOW_TYPE - first value is `windowtype`
# WM_WINDOW_ROLE - windowrole

hc rule --focus=on # normally focus new clients
hc rule --floatplacement=smart

hc rule --windowtype~'_NET_WM_WINDOW_TYPE_(DIALOG|UTILITY|SPLASH)' --floating=on
hc rule --windowtype='_NET_WM_WINDOW_TYPE_DIALOG' --focus=on --floatplacement=center
hc rule --windowtype='_NET_WM_WINDOW_TYPE_SPLASH' --focus=on --floatplacement=center --hook=splash_opened
hc rule --windowtype~'_NET_WM_WINDOW_TYPE_(NOTIFICATION|DOCK|DESKTOP)' --manage=off

# autostart rules: tags and indexes come from the connected monitor set (hlwm_tag_layouts.conf)
source $SCRIPTS_DIR/tag_programs.sh
hc rule once --instance=vivaldi-stable --tag="${PROG_TAG[vivaldi-stable]}" --index="${PROG_INDEX[vivaldi-stable]}"
hc rule once --instance=md.obsidian.obsidian --tag="${PROG_TAG[md.obsidian.obsidian]}" --index="${PROG_INDEX[md.obsidian.obsidian]}"
hc rule once --instance=spotify --tag="${PROG_TAG[spotify]}" --index="${PROG_INDEX[spotify]}"
hc rule --instance=rambox --tag="${PROG_TAG[rambox]}" --index="${PROG_INDEX[rambox]}" --label=rambox-startup-onetime
# rambox doesn't stay where it should, so naming to unrule down the line

# floating windows
hc rule --title='Bitwarden - Vivaldi' --floating=true --floatplacement=center

hc rule --instance='bambu-studio' fixedsize --floating=true --floatplacement=center
hc rule --instance='expressvpn-client' fixedsize --floating=true --floatplacement=center
hc rule --instance=pavucontrol --floating=true --floatplacement=center
hc rule --instance~'^Minecraft.*$' --floating=true --floatplacement=center
hc rule --instance='dragon-drop' --floating=true --floatplacement=center
hc rule --instance=gpick --floating=true --floating_geometry=620x422
hc rule --instance~'(urxvt|xterm)' --floating=true --floatplacement=center --floating_geometry=948x502
hc rule --instance=wrapper --hook=wrapper_opened --floating=true --floatplacement=center --floating_geometry=1280x720

hc rule --instance=peek --hook=peek_opened
