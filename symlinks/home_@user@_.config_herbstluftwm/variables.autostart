#!/usr/bin/env bash

hc() {
    herbstclient "$@"
}

DOTFILES_DIR=$(cd -P "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
export DOTFILES_DIR
source "$DOTFILES_DIR/setup/colours.sh"
col_active=$col_green
col_urgent=$col_purple

SCRIPTS_DIR=~/.config/herbstluftwm/scripts
wallpaper=~/Pictures/Wallpapers/rm.png
ModPri=Mod4+Mod1    # Super+Alt
ModSup=Mod4         # Super