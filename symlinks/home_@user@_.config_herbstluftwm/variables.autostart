#!/usr/bin/env bash

hc() {
    herbstclient "$@"
}

colours_dir=$(cd -P "$(dirname "${BASH_SOURCE[0]}")/../../setup" && pwd)
source "$colours_dir/colours.sh"
col_active=$col_green

SCRIPTS_DIR=~/.config/herbstluftwm/scripts
wallpaper=~/Pictures/Wallpapers/rm.png
ModPri=Mod4+Mod1    # Super+Alt
ModSup=Mod4         # Super