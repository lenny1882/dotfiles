#define nord0 #2E3440
#define nord1 #3B4252
#define nord2 #434C5E
#define nord3 #4C566A
#define nord4 #D8DEE9
#define nord5 #E5E9F0
#define nord6 #ECEFF4
#define nord7 #8FBCBB
#define nord8 #88C0D0
#define nord9 #81A1C1
#define nord10 #5E81AC
#define nord11 #BF616A
#define nord12 #D08770
#define nord13 #EBCB8B
#define nord14 #A3BE8C
#define nord15 #B48EAD

#define col_dark #252526
#define col_light #ECEFF4
#define col_purple #7B1FA2
#define col_green #2E7D32

! *.color0: nord1
! *.color1: nord11
! *.color2: nord14
! *.color3: nord13
! *.color4: nord9
! *.color5: nord15
! *.color6: nord8
! *.color7: nord5
! *.color8: nord3
! *.color9: nord11
! *.color10: nord14
! *.color11: nord13
! *.color12: nord9
! *.color13: nord15
! *.color14: nord7
! *.color15: nord6

*.foreground:   col_light
*.background:   col_dark
*.cursorColor:  col_light

!! ================================
!! Terminal

!! urxvt
! use class name for global settings - URxvt
! use instance name for specific settings - urxvt, nnn, etc.
! fc-list |grep DejaVu
URxvt*font: xft:DejaVuSansM Nerd Font Mono:autohint=true:size=11,xft:Braille
URxvt*depth: 32
URxvt*background: [80]col_dark
URxvt.letterSpace: 0
URxvt.lineSpace: 0
URxvt.internalBorder: 8
URxvt.cursorBlink: true
URxvt.cursorUnderline: false
URxvt.saveline: 2048
URxvt.scrollBar: false
URxvt.scrollBar_right: false
URxvt.urgentOnBell: true
URxvt.iso14755: false
URxvt.iso14755_52: false
URxvt.keysym.Control-Up: \033[1;5A
URxvt.keysym.Control-Down: \033[1;5B
URxvt.keysym.Control-Left: \033[1;5D
URxvt.keysym.Control-Right: \033[1;5C
URxvt.keysym.C-BackSpace: command:\000
URxvt.perl-ext-common:-confirm-paste

!! urxvt - nnn
nnn*background: [95]col_dark

!! urxvt - bottom
bottom*background: [95]col_dark

!! urxvt - wrapper
wrapper*background: [95]col_dark