# TRAP: https://unix.stackexchange.com/a/666676
# SUBSHELL: https://stackoverflow.com/a/53861286
# ERRORS: https://medium.com/@dirk.avery/the-bash-trap-trap-ce6083f36700
#         http://redsymbol.net/articles/bash-exit-traps/

# NVM# export NVM_DIR=/media/Storage/Development/.nvm
# [ -s /media/Storage/Development/.nvm/nvm.sh ] && \. /media/Storage/Development/.nvm/nvm.sh  # This loads nvm
# [ -s /media/Storage/Development/.nvm/bash_completion ] && \. /media/Storage/Development/.nvm/bash_completion

# https://www.growingwiththeweb.com/2018/01/slow-nvm-init.html
# Defer initialization of nvm until nvm, node or a node-dependent command is
# run. Ensure this block is only run once if .bashrc gets sourced multiple times
# by checking whether __init_nvm is a function.
export NVM_DIR=/media/Storage/Development/.nvm
if [ -s "$NVM_DIR/nvm.sh" ] && [ ! "$(type -t __init_nvm)" = function ]; then
  declare -a __node_commands=('nvm' 'node' 'npm' 'yarn' 'gulp' 'grunt' 'webpack' 'npx' 'node-init')
  function __init_nvm() {
    for i in "${__node_commands[@]}"; do unalias $i; done
    . "$NVM_DIR"/nvm.sh
    unset __node_commands
    unset -f __init_nvm
  }
  for i in "${__node_commands[@]}"; do alias $i='__init_nvm && '$i; done
  [ -s "$NVM_DIR/bash_completion" ] && . "$NVM_DIR/bash_completion"
fi

node-init() {
	echo "Initialising node"
	node --version
	$1
}
alias node-init=node-init
