# git PS1 info
source /usr/share/git/git-prompt.sh
export GIT_PS1_SHOWDIRTYSTATE=1
export GIT_PS1_SHOWSTASHSTATE=1
export GIT_PS1_SHOWUNTRACKEDFILES=1
export GIT_PS1_SHOWUPSTREAM=1

source "$(dirname "${BASH_SOURCE[0]}")/../setup/colours.sh"

# colourful man
_man_blink=$'\e[38;2;'$(colour_rgb nnn_context3)'m'
_man_reverse=$'\e[48;2;'$(colour_rgb ansi_cyan)'m'
_man_underline=$'\e[38;2;'$(colour_rgb col_red)'m'
man() {
    local ltc_mb=$'\e[1;31m'                # begin bold
    local ltc_md=$_man_blink                # begin blink
    local ltc_so=$_man_reverse              # begin reverse video
    local ltc_us=$_man_underline            # begin underline
    local ltc_me=$'\e[0m'                   # reset bold/blink
    local ltc_se=$'\e[0m'                   # reset reverse video
    local ltc_ue=$'\e[0m'                   # reset underline
    local ltc_mr=$(tput rev)                #
    local ltc_mh=$(tput dim)                #
    local ltc_ZN=$(tput ssubm)              #
    local ltc_ZV=$(tput rsubm)              #
    local ltc_ZO=$(tput ssupm)              #
    local ltc_ZW=$(tput rsupm)              #

    env \
        LESS_TERMCAP_mb=$ltc_mb \
        LESS_TERMCAP_md=$ltc_md \
        LESS_TERMCAP_me=$ltc_me \
        LESS_TERMCAP_se=$ltc_se \
        LESS_TERMCAP_so=$ltc_so \
        LESS_TERMCAP_ue=$ltc_ue \
        LESS_TERMCAP_us=$ltc_us \
            /usr/bin/man "$@"
}
export GROFF_NO_SGR=1
export PAGER='less -iFJMRsW --mouse +Gg'

# enable CTRL+S to go forward in bash history search
[[ $- == *i* ]] && stty -ixon


